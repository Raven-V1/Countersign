# .gitattributes
* text=auto

# Ensure the pre-commit hook always has Unix line endings on every platform.
hooks/pre-commit           text eol=lf

# Files whose content the generate_bob_rules script writes must stay LF.
countersign.yaml           text eol=lf
.bob/rules/countersign.md  text eol=lf
.bobignore                 text eol=lf

# Files whose SHA-256 is checked or chained must never have line endings
# rewritten by Git -- binary mode preserves bytes exactly.
records/*.json             binary
.countersign/*             binary
.leak-baseline.json        binary

# z/OS artefacts -- keep LF so USS Python and BPXBATCH see consistent bytes.
zos/*.jcl                  text eol=lf
zos/*.py                   text eol=lf
